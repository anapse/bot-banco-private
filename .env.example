# ============================================================
#  BDV Bot Web — secretos (NUNCA compartir este archivo)
#  Misma carpeta que server.js. Solo se lee desde el servidor.
# ============================================================

# --- Modo REAL: token de acceso OAuth (opcional en modo SIM) ---
# Se obtiene haciendo login en la app y capturando el access_token,
# o dejando que el bot haga el login con las credenciales de abajo
# (contrato de login a validar — ver README).
BDV_ACCESS_TOKEN=

# --- Credenciales (solo modo real, bajo tu responsabilidad) ---
BDV_USERNAME=
BDV_PASSWORD=

# --- Refresh token (recomendado): el bot renueva la sesión sin pedir clave ---
# Sácalo de un login real (captura de tráfico) o del login automático.
BDV_REFRESH_TOKEN=

# --- Telegram (opcional): avisos al celular cuando compres ---
# Crea un bot con @BotFather, obten el token y tu chat_id.
TG_BOT_TOKEN=
TG_CHAT_ID=
